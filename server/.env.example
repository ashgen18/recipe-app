# TheMealDB API configuration (key stays on the server only)
MEALDB_API_BASE=https://www.themealdb.com/api/json/v1
MEALDB_API_KEY=1

# Server port (Render sets PORT automatically in production)
PORT=5174

# Optional: comma-separated browser origins if the client is hosted separately
# CORS_ORIGINS=https://your-app.vercel.app
